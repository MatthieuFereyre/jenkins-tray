<UserControl x:Class="JenkinsTray.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="http://schemas.lepo.co/wpfui/2022/xaml"
             xmlns:vm="clr-namespace:JenkinsTray.ViewModels"
             xmlns:ctl="clr-namespace:JenkinsTray.Controls"
             xmlns:models="clr-namespace:JenkinsTray.Models"
             xmlns:loc="clr-namespace:JenkinsTray.Services"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="24,20,16,24">
        <StackPanel MaxWidth="820" HorizontalAlignment="Left">

            <TextBlock Text="{loc:Tr Settings_Title}" Style="{StaticResource PageTitleStyle}" />
            <TextBlock Style="{StaticResource PageCaptionStyle}"
                       Text="{loc:Tr Settings_Caption}" />

            <!-- Servers -->
            <TextBlock Style="{StaticResource SectionLabelStyle}" ctl:TrackedText.Text="{loc:Tr Settings_SectionServers}" />

            <Border Style="{StaticResource SurfacePanelStyle}" Margin="2,0,6,0">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Servers}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ServerConfig}">
                                <StackPanel>
                                    <ctl:SettingsRow Symbol="Server24"
                                                     Header="{Binding Name}"
                                                     Description="{Binding Summary, Mode=OneWay}">
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource IconButtonStyle}"
                                                    ToolTip="{loc:Tr Settings_Edit}"
                                                    Command="{Binding DataContext.EditServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Edit24" FontSize="14"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Button>
                                            <Button Style="{StaticResource IconButtonDangerStyle}"
                                                    Margin="4,0,0,0"
                                                    ToolTip="{loc:Tr Settings_Delete}"
                                                    Command="{Binding DataContext.DeleteServerCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <ui:SymbolIcon Symbol="Delete24" FontSize="14"
                                                               Foreground="{DynamicResource TextSecondaryBrush}" />
                                            </Button>
                                        </StackPanel>
                                    </ctl:SettingsRow>

                                    <Border Style="{StaticResource RowDividerStyle}" />
                                </StackPanel>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <TextBlock Margin="16,14,16,0"
                               Style="{StaticResource TertiaryTextStyle}"
                               Text="{loc:Tr Settings_NoServerYet}"
                               Visibility="{Binding HasServers, Converter={StaticResource InvBoolToVis}}" />

                    <ui:Button Content="{loc:Tr Settings_AddServer}"
                               Icon="{ui:SymbolIcon Add24}"
                               Appearance="Primary"
                               Margin="16,14,16,16"
                               HorizontalAlignment="Left"
                               Command="{Binding AddServerCommand}" />
                </StackPanel>
            </Border>

            <!-- Monitoring -->
            <TextBlock Style="{StaticResource SectionLabelStyle}" ctl:TrackedText.Text="{loc:Tr Settings_SectionMonitoring}" />

            <Border Style="{StaticResource SurfacePanelStyle}" Margin="2,0,6,0">
                <StackPanel>
                    <ctl:SettingsRow Symbol="Timer24"
                                     Header="{loc:Tr Settings_PollInterval}"
                                     Description="{loc:Tr Settings_PollIntervalDesc}">
                        <ui:NumberBox Value="{Binding PollIntervalSeconds, Mode=TwoWay}"
                                      Minimum="5" Maximum="3600" SmallChange="5" LargeChange="30"
                                      MaxDecimalPlaces="0" Width="140" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Folder24"
                                     Header="{loc:Tr Settings_DiscoveryDepth}"
                                     Description="{loc:Tr Settings_DiscoveryDepthDesc}">
                        <ui:NumberBox Value="{Binding DiscoveryDepth, Mode=TwoWay}"
                                      Minimum="1" Maximum="10" SmallChange="1" LargeChange="1"
                                      MaxDecimalPlaces="0" Width="140" />
                    </ctl:SettingsRow>
                </StackPanel>
            </Border>

            <!-- Notifications -->
            <TextBlock Style="{StaticResource SectionLabelStyle}" ctl:TrackedText.Text="{loc:Tr Settings_SectionNotifications}" />

            <Border Style="{StaticResource SurfacePanelStyle}" Margin="2,0,6,0">
                <StackPanel>
                    <ctl:SettingsRow Symbol="CheckmarkCircle24" Header="{loc:Tr Settings_NotifySuccess}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnSuccess, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Warning24" Header="{loc:Tr Settings_NotifyUnstable}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnUnstable, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="ErrorCircle24" Header="{loc:Tr Settings_NotifyFailure}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnFailure, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Dismiss24" Header="{loc:Tr Settings_NotifyAborted}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnAborted, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Filter24"
                                     Header="{loc:Tr Settings_OnlyStatusChange}"
                                     Description="{loc:Tr Settings_OnlyStatusChangeDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding NotifyOnlyOnStatusChange, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Alert24" Header="{loc:Tr Settings_PlaySound}">
                        <ui:ToggleSwitch IsChecked="{Binding PlaySound, Mode=TwoWay}" />
                    </ctl:SettingsRow>
                </StackPanel>
            </Border>

            <!-- Application -->
            <TextBlock Style="{StaticResource SectionLabelStyle}" ctl:TrackedText.Text="{loc:Tr Settings_SectionApplication}" />

            <Border Style="{StaticResource SurfacePanelStyle}" Margin="2,0,6,0">
                <StackPanel>
                    <ctl:SettingsRow Symbol="WeatherMoon24" Header="{loc:Tr Settings_Theme}">
                        <ComboBox SelectedIndex="{Binding ThemeIndex, Mode=TwoWay}" Width="160">
                            <ComboBoxItem Content="{loc:Tr Settings_ThemeSystem}" />
                            <ComboBoxItem Content="{loc:Tr Settings_ThemeLight}" />
                            <ComboBoxItem Content="{loc:Tr Settings_ThemeDark}" />
                        </ComboBox>
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="LocalLanguage24"
                                     Header="{loc:Tr Settings_Language}"
                                     Description="{loc:Tr Settings_LanguageDesc}">
                        <ComboBox SelectedIndex="{Binding LanguageIndex, Mode=TwoWay}" Width="160">
                            <ComboBoxItem Content="{loc:Tr Settings_LanguageSystem}" />
                            <!-- Endonyms: a language is picked by someone who reads it, and would
                                 not recognise it under the name the current interface gives it. -->
                            <ComboBoxItem Content="English" />
                            <ComboBoxItem Content="Français" />
                        </ComboBox>
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Power24" Header="{loc:Tr Settings_StartWithWindows}">
                        <ui:ToggleSwitch IsChecked="{Binding StartWithWindows, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Eye24" Header="{loc:Tr Settings_StartMinimized}">
                        <ui:ToggleSwitch IsChecked="{Binding StartMinimized, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Dismiss24"
                                     Header="{loc:Tr Settings_CloseToTray}"
                                     Description="{loc:Tr Settings_CloseToTrayDesc}">
                        <ui:ToggleSwitch IsChecked="{Binding MinimizeToTrayOnClose, Mode=TwoWay}" />
                    </ctl:SettingsRow>

                    <Border Style="{StaticResource RowDividerStyle}" />

                    <ctl:SettingsRow Symbol="Folder24"
                                     Header="{loc:Tr Settings_ConfigFile}"
                                     Description="{Binding SettingsFilePath}">
                        <ui:Button Content="{loc:Tr Settings_OpenFolder}" Appearance="Secondary"
                                   Command="{Binding OpenSettingsFolderCommand}" />
                    </ctl:SettingsRow>
                </StackPanel>
            </Border>

            <TextBlock Margin="4,18,0,0"
                       Style="{StaticResource TertiaryTextStyle}"
                       TextWrapping="Wrap"
                       Text="{loc:Tr Settings_TokenNotice}" />
        </StackPanel>
    </ScrollViewer>
</UserControl>
